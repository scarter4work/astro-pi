+def test_escaped_quotes_in_string_value(make_fits):
+    """FITS standard: '' inside a quoted string means one literal '"""
+    p = make_fits("e.fit", {"OBJECT": "'Barnard''s Loop'"})
+    assert fitsheader.read_header(p)["OBJECT"] == "Barnard's Loop"
