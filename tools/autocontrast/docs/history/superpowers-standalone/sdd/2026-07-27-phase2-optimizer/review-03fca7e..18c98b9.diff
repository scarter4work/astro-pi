 def _img(h=96, w=96):
     y, x = np.mgrid[0:h, 0:w]
     base = 0.35 + 0.15 * np.sin(x / 8.0) * np.cos(y / 11.0)
     return np.clip(np.stack([base, base * 0.9, base * 1.1], axis=-1), 0.0, 1.0)
 
 
