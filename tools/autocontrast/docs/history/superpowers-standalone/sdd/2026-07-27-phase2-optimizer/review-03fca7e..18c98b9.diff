 def test_executor_does_not_mutate_its_input():
     ex, src = NumpyExecutor(), _img()
     before = src.copy()
     ex.apply(src, Action("tonal_reshape", "strong", None, {}), pixel_scale_arcsec=1.0)
     assert np.array_equal(src, before)
 
 
