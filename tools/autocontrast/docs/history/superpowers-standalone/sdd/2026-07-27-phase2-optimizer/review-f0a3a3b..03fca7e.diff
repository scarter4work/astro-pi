+
+from typing import Protocol
+
+import numpy as np
+
+from .actions import Action
+
+
+class Executor(Protocol):
+    def apply(
+        self, rgb: np.ndarray, action: Action, *, pixel_scale_arcsec: float
+    ) -> np.ndarray:
