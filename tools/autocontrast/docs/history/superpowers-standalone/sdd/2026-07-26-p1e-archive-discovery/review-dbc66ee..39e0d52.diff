+    attribution: str | None
+    published_utc: str | None
+    parsed_ok: bool
+
+    @property
+    def has_position(self) -> bool:
+        return (self.ra_deg is not None and self.dec_deg is not None
+                and self.fov_radius_arcmin is not None)
+
