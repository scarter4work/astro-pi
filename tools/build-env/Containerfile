# astro-pi portable module build environment.
#
# WHY: a PixInsight module built on the dev box (Fedora 44: glibc 2.43, GCC 16)
# records the dev box's symbol versions (GLIBC_2.43 atan2f/sqrtf/log10f,
# GLIBCXX_3.4.32) and, for NukeX, NEEDs Fedora-only sonames (libceres.so.4,
# libglog.so.2, libgflags.so.2.2). Such a module loads here and nowhere else.
# The PixInsight 1.9.5 core itself requires only GLIBC_2.34 / GLIBCXX_3.4.30,
# so modules are built on Rocky Linux 9 (glibc 2.34) with gcc-toolset-14:
# a modern compiler whose newer libstdc++ pieces are linked statically
# (libstdc++_nonshared), leaving the runtime floor at the base system's
# GLIBCXX_3.4.29.
#
# Third-party C++ deps that are not universally installed are built here as
# STATIC, position-independent archives and linked into the module:
#   - Ceres 2.2.0 (miniglog, no gflags/SuiteSparse/LAPACK/CUDA; NukeX only uses
#     GradientProblemSolver + BFGS line search, so no linear-solver backend)
#   - Khronos OpenCL ICD loader (vendor ICDs are still dlopen'ed at runtime
#     from /etc/OpenCL/vendors, so GPU drivers work exactly as before)
#   - Eigen 5.0.1 (header-only; same version as the dev box)
FROM docker.io/rockylinux/rockylinux:9

RUN dnf -y install dnf-plugins-core \
 && dnf -y install gcc-toolset-14-gcc gcc-toolset-14-gcc-c++ \
                   cmake make git patch tar gzip unzip xz zlib-devel binutils \
 && dnf clean all

ENV PATH=/opt/rh/gcc-toolset-14/root/usr/bin:$PATH \
    CC=/opt/rh/gcc-toolset-14/root/usr/bin/gcc \
    CXX=/opt/rh/gcc-toolset-14/root/usr/bin/g++ \
    DEPS=/opt/deps

# Every third-party input is pinned by checksum or full commit: these bytes
# end up inside modules signed with the release key.
ARG EIGEN_VER=5.0.1
ARG EIGEN_SHA256=e9c326dc8c05cd1e044c71f30f1b2e34a6161a3b6ecf445d56b53ff1669e3dec
ARG CERES_VER=2.2.0
ARG CERES_SHA256=12efacfadbfdc1bbfa203c236e96f4d3c210bed96994288b3ff0c8e7c6f350d4
# Khronos tag v2025.07.22
ARG OPENCL_HEADERS_COMMIT=8a97ebc88daa3495d6f57ec10bb515224400186f
ARG OPENCL_ICD_COMMIT=ad770a1b64c6b8d5f2ed4e153f22e4f45939f27f

WORKDIR /tmp/src
RUN curl -fsSL -o eigen.tgz https://gitlab.com/libeigen/eigen/-/archive/${EIGEN_VER}/eigen-${EIGEN_VER}.tar.gz \
 && echo "${EIGEN_SHA256}  eigen.tgz" | sha256sum -c - && tar xzf eigen.tgz \
 && cmake -S eigen-${EIGEN_VER} -B eigen-build -DCMAKE_INSTALL_PREFIX=$DEPS \
          -DEIGEN_BUILD_TESTING=OFF -DEIGEN_BUILD_DOC=OFF -DBUILD_TESTING=OFF \
          -DEIGEN_BUILD_BLAS=OFF -DEIGEN_BUILD_LAPACK=OFF \
 && cmake --install eigen-build \
 && rm -rf /tmp/src/*

RUN git clone -q https://github.com/KhronosGroup/OpenCL-Headers.git \
 && git -C OpenCL-Headers checkout -q ${OPENCL_HEADERS_COMMIT} \
 && git clone -q https://github.com/KhronosGroup/OpenCL-ICD-Loader.git \
 && git -C OpenCL-ICD-Loader checkout -q ${OPENCL_ICD_COMMIT} \
 && cmake -S OpenCL-Headers -B headers-build -DCMAKE_INSTALL_PREFIX=$DEPS -DBUILD_TESTING=OFF \
 && cmake --install headers-build \
 && cmake -S OpenCL-ICD-Loader -B icd-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$DEPS \
          -DCMAKE_PREFIX_PATH=$DEPS -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
          -DBUILD_TESTING=OFF -DENABLE_OPENCL_LAYERINFO=OFF \
 && cmake --build icd-build -j"$(nproc)" && cmake --install icd-build \
 && rm -rf /tmp/src/*

# Upstream Ceres commit f9b7b66 ("Support Eigen3 5.0.0"), as cherry-picked by
# Fedora's ceres-solver package; 2.2.0 predates Eigen 5.
COPY ceres-solver-Support-Eigen3-5.0.0.patch /tmp/
RUN curl -fsSL -o ceres.tgz https://github.com/ceres-solver/ceres-solver/archive/refs/tags/${CERES_VER}.tar.gz \
 && echo "${CERES_SHA256}  ceres.tgz" | sha256sum -c - && tar xzf ceres.tgz \
 && patch -d ceres-solver-${CERES_VER} -p1 < /tmp/ceres-solver-Support-Eigen3-5.0.0.patch \
 && cmake -S ceres-solver-${CERES_VER} -B ceres-build -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=$DEPS -DCMAKE_PREFIX_PATH=$DEPS \
          -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
          -DMINIGLOG=ON -DGFLAGS=OFF -DSUITESPARSE=OFF -DLAPACK=OFF -DUSE_CUDA=OFF \
          -DEIGENSPARSE=ON -DSCHUR_SPECIALIZATIONS=OFF \
          -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARKS=OFF -DBUILD_DOCUMENTATION=OFF \
 && cmake --build ceres-build -j"$(nproc)" && cmake --install ceres-build \
 && rm -rf /tmp/src/*

# PCL static libraries, rebuilt here. The dev box's ~/PCL/lib/x64 archives
# were compiled against glibc 2.43 headers and reference glibc-2.38+ C23 entry
# points (__isoc23_strtol & co.), which glibc 2.34 does not have -- so they
# cannot be linked into a portable module.
#
# Source: PCL 2.13.0 build 1072, the tree bundled with PixInsight 1.9.6
# (/opt/PixInsight/include/pcl + src/{pcl,3rdparty}), packed reproducibly by
# pcl-2.13/make-tarball.sh and pinned by pcl-2.13/SHA256SUMS. Upstream gitlab
# has not published 2.13 (its master is 2.11.0); 2.13 is the first PCL with
# BlindAstrometricSolver. Its makefiles compile with -std=c++20, so every
# module including these headers builds as C++20. image-tag.sh hashes
# SHA256SUMS, so a re-pin builds a NEW image.
ENV PCLDIR=/opt/pcl
COPY pcl-2.13/SHA256SUMS pcl-2.13/PCL-2.13.0-1072.tar.gz /tmp/pcl/
RUN cd /tmp/pcl && sha256sum -c SHA256SUMS \
 && mkdir -p $PCLDIR && tar -C $PCLDIR -xzf PCL-2.13.0-1072.tar.gz \
 && rm -rf /tmp/pcl \
 && grep -q 'Released 2026-10-28' $PCLDIR/src/pcl/Version.cpp \
 && test -f $PCLDIR/include/pcl/BlindAstrometricSolver.h \
 && mkdir -p $PCLDIR/lib/x64 \
 && for d in 3rdparty/cminpack 3rdparty/lcms 3rdparty/lz4 3rdparty/RFC6234 3rdparty/zlib 3rdparty/zstd pcl; do \
      mkdir -p $PCLDIR/src/$d/linux/g++/x64/Release && \
      make -C $PCLDIR/src/$d/linux/g++ -f makefile-x64 -j"$(nproc)" \
           PCLSRCDIR=$PCLDIR/src PCLINCDIR=$PCLDIR/include PCLLIBDIR64=$PCLDIR/lib/x64 \
           all >/dev/null || exit 1; \
    done \
 && ls $PCLDIR/lib/x64 \
 && ! nm -u $PCLDIR/lib/x64/*.a 2>/dev/null | grep -q __isoc23 \
 && find $PCLDIR/src -name '*.o' -delete

WORKDIR /src
