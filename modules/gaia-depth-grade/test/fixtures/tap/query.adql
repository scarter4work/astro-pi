SELECT TOP 5 g.ra, g.dec, d.r_med_geo, d.r_lo_geo, d.r_hi_geo, g.source_id, g.phot_g_mean_mag, g.bp_rp FROM gaiadr3.gaia_source AS g JOIN external.gaiaedr3_distance AS d ON g.source_id = d.source_id WHERE 1 = CONTAINS(POINT('ICRS', g.ra, g.dec), CIRCLE('ICRS', 350.1671987228608, 61.22006490843979, 0.02)) AND d.r_med_geo IS NOT NULL AND g.phot_g_mean_mag IS NOT NULL AND g.phot_g_mean_mag < 18.0 ORDER BY g.phot_g_mean_mag ASC