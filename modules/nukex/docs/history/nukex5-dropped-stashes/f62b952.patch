++/// Local background luminance, in the image's OWN units.
++///
++/// A 16x16 block median, bilinearly interpolated between block centres.
++/// Median because a star occupies a handful of a block's 256 pixels and must
++/// not lift its own background -- if it did, a star would look as "extended"
++/// as a nebula and convergence could not tell them apart. Extended structure
++/// fills the block and does move it, which is exactly the discrimination
++/// wanted.
++std::vector<float> block_median_background(const Image& img,
++                                           float w_R, float w_G, float w_B) {
++    const int w = img.width(), h = img.height();
++    const std::size_t n = static_cast<std::size_t>(w) * h;
++    if (w <= 0 || h <= 0) return {};
++
++    constexpr int BLK = 16;
++    const int bw = (w + BLK - 1) / BLK, bh = (h + BLK - 1) / BLK;
++    const bool colour = img.n_channels() >= 3;
++    const float* c0 = img.channel_data(0);
++    const float* c1 = colour ? img.channel_data(1) : nullptr;
++    const float* c2 = colour ? img.channel_data(2) : nullptr;
++
++    std::vector<float> coarse(static_cast<std::size_t>(bw) * bh, 0.0f);
++    std::vector<float> cell;
++    cell.reserve(BLK * BLK);
++    for (int by = 0; by < bh; ++by)
++        for (int bx = 0; bx < bw; ++bx) {
++            cell.clear();
++            const int y1 = std::min(h, (by + 1) * BLK), x1 = std::min(w, (bx + 1) * BLK);
++            for (int y = by * BLK; y < y1; ++y)
++                for (int x = bx * BLK; x < x1; ++x) {
++                    const std::size_t i = static_cast<std::size_t>(y) * w + x;
++                    cell.push_back(colour ? w_R * c0[i] + w_G * c1[i] + w_B * c2[i]
++                                          : c0[i]);
++                }
++            if (cell.empty()) continue;
++            const std::size_t m = cell.size() / 2;
++            std::nth_element(cell.begin(), cell.begin() + m, cell.end());
++            coarse[static_cast<std::size_t>(by) * bw + bx] = cell[m];
++        }
++
++    // Bilinear between block centres, clamped at the edges.
++    std::vector<float> out(n, 0.0f);
++    for (int y = 0; y < h; ++y) {
++        const float fy = (static_cast<float>(y) - 0.5f * (BLK - 1)) / BLK;
++        const int y0 = std::clamp(static_cast<int>(std::floor(fy)), 0, bh - 1);
++        const int y2 = std::clamp(y0 + 1, 0, bh - 1);
++        const float ty = std::clamp(fy - static_cast<float>(y0), 0.0f, 1.0f);
++        for (int x = 0; x < w; ++x) {
++            const float fx = (static_cast<float>(x) - 0.5f * (BLK - 1)) / BLK;
++            const int x0 = std::clamp(static_cast<int>(std::floor(fx)), 0, bw - 1);
++            const int x2 = std::clamp(x0 + 1, 0, bw - 1);
++            const float tx = std::clamp(fx - static_cast<float>(x0), 0.0f, 1.0f);
++            const float a = coarse[static_cast<std::size_t>(y0) * bw + x0];
++            const float bb = coarse[static_cast<std::size_t>(y0) * bw + x2];
++            const float c = coarse[static_cast<std::size_t>(y2) * bw + x0];
++            const float d = coarse[static_cast<std::size_t>(y2) * bw + x2];
++            out[static_cast<std::size_t>(y) * w + x] =
++                (a * (1 - tx) + bb * tx) * (1 - ty) + (c * (1 - tx) + d * tx) * ty;
++        }
++    }
++    return out;
++}
++
++} // namespace
