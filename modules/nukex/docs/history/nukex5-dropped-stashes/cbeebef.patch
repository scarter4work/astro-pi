      float auto_tune(const Image& img, float target_background = 0.12f);
  
++    /// Per-pixel local background luminance, width*height, row-major.
++    ///
++    /// Convergence-to-white exists to whiten STAR CORES, but it decided on
++    /// absolute luminance, so on narrowband -- where the nebula is the
++    /// brightest thing in frame -- it whitened the nebula too. A local
++    /// background separates the two for free: it is a median over a window, so
++    /// inside an extended object the window is itself that object and the
++    /// excess is ~0, while a star fills only a few of the window's pixels and
++    /// its excess is large.
++    ///
++    /// Optional. Supply nothing and convergence falls back to absolute
++    /// luminance, which is bit-for-bit the previous behaviour.
++    void set_local_background(std::vector<float> bg);
++
      /// Scalar version: stretches a single luminance value.
      float apply_scalar(float x) const override;
  
      std::map<std::string, std::pair<float, float>> param_bounds() const override;
      bool                                           set_param(const std::string&, float) override;
      std::optional<float>                           get_param(const std::string&) const override;
++
++private:
++    /// Not a tunable parameter -- it is per-image measured data, so it is
++    /// deliberately outside the param block that param_bounds/set_param expose.
++    /// Empty means "no spatial context supplied": convergence then uses
++    /// absolute luminance, exactly as before.
++    std::vector<float> local_bg_;
  };
  
