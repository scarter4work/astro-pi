+
+TEST_CASE("default_reference_channel: green for colour, channel 0 for mono",
+          "[star_detector]") {
+    REQUIRE(nukex::default_reference_channel(1) == 0);
+    REQUIRE(nukex::default_reference_channel(2) == 0);
