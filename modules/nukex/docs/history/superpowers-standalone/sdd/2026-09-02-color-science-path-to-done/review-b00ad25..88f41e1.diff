 def median_lines(entries):
     """Same line set across several products -> one entry with median FWHM per line."""
     by_name = {}
     order = []
     for lines in entries:
         for l in lines:
             if l["name"] not in by_name:
                 order.append(l["name"])
                 by_name[l["name"]] = []
             by_name[l["name"]].append(l["fwhm_nm"])
