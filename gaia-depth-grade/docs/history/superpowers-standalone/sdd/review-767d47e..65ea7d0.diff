+def _gaussian_star(img, x, y, flux, sigma):
+    ny, nx = img.shape
+    yy, xx = np.mgrid[0:ny, 0:nx]
+    img += flux * np.exp(-((xx - x) ** 2 + (yy - y) ** 2) / (2 * sigma**2))
+
