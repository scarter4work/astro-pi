      </package>
      <package fileName="EZHazeKill_v1.0.1.zip" sha1="d1145bb5b3dbb4f847b3985e0d0bc29df7d86b64" type="script" releaseDate="20261004">
         <title>EZ Haze Kill</title>
         <description>
            <p>
