+      assert(typeof r2.errorMsg == "string" && r2.errorMsg.trim().length > 0, "errorMsg must be a non-empty string on failure");
+      W("negative-path errorMsg: " + r2.errorMsg);
+
+      RCAstro.cleanup([badInP, badOutP]);
+
+      W("PASS t_lib_runcli");
+   } catch (e) {
+      W("FAIL: " + e.message);
+   }
+   log.close();
+}
+main();
